{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "ivory",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#boolean"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.ivory",
					"match": "\\b(if|while|for|loop|return|else|as|do|import|export|from|await|break|continue)\\b"
				},
				{
					"name": "storage.type.ivory",
					"match": "\\b(func|mut|var|const|struct|trait|impl|async|type|enum|static)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.ivory",
					"match": "([+\\-*\\/%]?=)"
				},
				{
					"name": "keyword.operator.arithmetic.ivory",
					"match": "(\\+|-|\\*|\/|%)"
				},
				{
					"name": "keyword.operator.bitwise.ivory",
					"match": "(\\||&|\\^|<<|>>|~)"
				},
				{
					"name": "keyword.operator.comparison.ivory",
					"match": "([<>]=?|==|!=)"
				},
				{
					"name": "keyword.operator.logical.ivory",
					"match": "(\\b(and|or|not)\\b|&&|\\|\\||!)"
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.ivory",
			"match": "\\d+(\\.\\d+)?"
		},
		"boolean": {
			"name": "constant.language.ivory",
			"match": "\\b(true|false)\\b"
		},
		"comments": {
			"name": "comment.line.number-sign.ivory",
			"begin": "#",
			"end": "\n"
		},
		"functions": {
			"name": "entity.name.function.ivory",
			"match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\()"
		},
		"variables": {
			"patterns": [
				{
					"name": "entity.name.type.ivory",
					"match": "\\b[A-Z_][a-zA-Z0-9_]*\\b"
				},
				{
					"name": "variable.other.ivory",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.ivory",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.ivory",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.ivory"
}
